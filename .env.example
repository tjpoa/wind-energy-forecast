WEATHER_API_KEY=
WEATHER_API_LOCATION=41.8345,-7.7889
WEATHER_API_DAYS=44
WEATHER_API_END_DATE=
# Optional local batch selections. These paths are not secrets.
WIND_FORECAST_BATCH_MODEL_BUNDLE=
WIND_FORECAST_BATCH_CALIBRATION_DIR=
# CDS credentials may be supplied here or through the scheduled user's .cdsapirc.
CDSAPI_URL=
CDSAPI_KEY=
# Exact browser origins allowed to call the FastAPI app, separated by commas.
# Do not use wildcards, paths, query strings, fragments, or credentials.
WIND_FORECAST_CORS_ALLOW_ORIGINS=http://localhost:5173
# Public browser endpoint compiled into the frontend image by Docker Compose.
VITE_API_BASE_URL=http://localhost:8000
# Host directory mounted read-only for the performance dashboard.
WIND_FORECAST_PERFORMANCE_ARTIFACT_HOST_DIR=./outputs/training/baseline
# Read-only Phase 9 store projected by the historical monitoring API.
WIND_FORECAST_MONITORING_STORE_ROOT=data/processed/v2/monitoring
# Optional operational-query projection. Disabled preserves the loader-only path
# and does not read the DSN or import/contact the PostgreSQL driver.
WIND_FORECAST_OPERATIONAL_PROJECTION_MODE=disabled
WIND_FORECAST_OPERATIONAL_ENVIRONMENT_ID=local
# Required only when the projection mode is exactly "required". Keep secrets in
# the ignored local .env or another approved user-level credential store.
WIND_FORECAST_OPERATIONAL_PROJECTION_READER_DSN=
