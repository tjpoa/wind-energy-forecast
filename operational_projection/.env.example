# Copy to operational_projection/.env and replace every placeholder locally.
# The .env file is ignored and must never be committed.
POSTGRES_PASSWORD=replace-with-a-dedicated-bootstrap-password
WIND_FORECAST_OPERATIONAL_PROJECTION_MIGRATOR_PASSWORD=replace-with-a-dedicated-migrator-password
WIND_FORECAST_OPERATIONAL_PROJECTION_WRITER_PASSWORD=replace-with-a-dedicated-writer-password
WIND_FORECAST_OPERATIONAL_PROJECTION_READER_PASSWORD=replace-with-a-dedicated-reader-password

# The Python management CLI consumes only these DSNs and the fixed local
# environment identity. The base Compose stack does not publish a host port;
# use the test overlay only for explicitly local migration/test work.
WIND_FORECAST_OPERATIONAL_ENVIRONMENT_ID=local
WIND_FORECAST_OPERATIONAL_PROJECTION_MIGRATOR_DSN=postgresql://wf_projection_migrator:replace-with-a-dedicated-migrator-password@127.0.0.1:5432/wind_forecast_operational
WIND_FORECAST_OPERATIONAL_PROJECTION_WRITER_DSN=postgresql://wf_projection_writer:replace-with-a-dedicated-writer-password@127.0.0.1:5432/wind_forecast_operational
WIND_FORECAST_OPERATIONAL_PROJECTION_READER_DSN=postgresql://wf_projection_reader:replace-with-a-dedicated-reader-password@127.0.0.1:5432/wind_forecast_operational
